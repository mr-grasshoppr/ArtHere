// Art Here Portland — Prisma schema
// Vercel Postgres (via DATABASE_URL connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users & Artists ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  artist    Artist?
  place     Place?
}

model Artist {
  id               String           @id @default(cuid())
  // Optional — an admin can create a bare profile page (e.g. a prototype to
  // pitch an artist) before any owner account exists. The invite flow
  // attaches a User later, the same way it already works for Place.
  userId           String?          @unique
  slug             String           @unique
  name             String
  bio              String?          @db.Text
  bioPhotoUrl      String?
  heroImageUrl     String?
  website          String?
  websiteLabel     String?
  instagram        String?
  medium           String?
  neighborhood     String?
  commissionStatus CommissionStatus @default(UNSPECIFIED)
  priceRangeMin    Int?
  priceRangeMax    Int?
  sizeRangeMin     Int?
  sizeRangeMax     Int?
  // Structured "what to hire this artist for" — checkbox selections plus any
  // custom entries the artist/admin added. hireFor stays in sync (a joined
  // sentence built from this array) so the existing AI search parsing that
  // reads hireFor keeps working unchanged.
  offerings        String[]         @default([])
  hireFor          String?          @db.Text
  hireTags         Json?
  isPlaceholder    Boolean          @default(false)
  // Set when the artist clicks "Submit for review" on their edit page — a
  // deliberate signal distinct from autosave. Cleared when an admin
  // publishes the profile (setArtistPlaceholder). Only meaningful while
  // isPlaceholder is true; publishing "consumes" the request.
  submittedForReviewAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  cityId           String?
  city             City?            @relation(fields: [cityId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])
  artworkImages    ArtworkImage[]
  placeRelations   ArtistPlace[]
  intake           ArtistIntake?
  adminNotes       AdminNote[]
  magicLinkTokens  MagicLinkToken[]
  links            ArtistLink[]

  @@index([cityId])
}

// A social/portfolio/shop link, one of several per artist. Superseded the old
// single website/instagram fields (still present on Artist, no longer written
// to — kept only so historical values aren't lost).
model ArtistLink {
  id        String   @id @default(cuid())
  artistId  String
  type      LinkType
  url       String
  // Custom label — mainly for type OTHER, where "Website"/"Instagram" etc.
  // wouldn't mean anything.
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

enum LinkType {
  WEBSITE
  PORTFOLIO
  SHOP
  PATREON
  INSTAGRAM
  FACEBOOK
  OTHER
}

enum CommissionStatus {
  OPEN
  CLOSED
  ON_REQUEST
  UNSPECIFIED
}

// ─── Artwork Images ───────────────────────────────────────────────────────────

model ArtworkImage {
  id         String    @id @default(cuid())
  artistId   String
  url        String
  cropBox    Json?     // {x,y,w,h} fractions — artwork bounds (excludes frame/wall)
  altText    String?
  sortOrder  Int       @default(0)
  isHero     Boolean   @default(false)
  uploadedAt DateTime  @default(now())

  // AI-generated tags stored as JSON
  // Shape: { medium, colors, scale, style, subjects, indoor_outdoor, mood }
  aiTags     Json?
  aiTaggedAt DateTime?
  // Structured, per-artwork medium — a normalized subset of aiTags.medium
  // (values restricted to MEDIUM_OPTIONS, see lib/artist-options.ts) so this
  // specific piece can be filtered/grouped by medium independently of the
  // artist's overall list of mediums. An admin can hand-correct this if the
  // AI mistags a piece.
  medium     String[]  @default([])

  artist     Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

// ─── Places ───────────────────────────────────────────────────────────────────

model Place {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  neighborhood String?
  description  String?       @db.Text
  // Optional pull quote shown on the page (e.g. a customer or community
  // testimonial), with its speaker credited separately.
  quote            String?   @db.Text
  quoteAttribution String?
  website      String?
  websiteLabel String?
  // heroImageUrl heads the org's own page; thumbnailImageUrl is the card shown
  // in the Community directory. When no thumbnail is set the hero is used.
  heroImageUrl String?
  thumbnailImageUrl String?
  // A few extra photos shown in a gallery on the place's page.
  galleryImages String[]     @default([])
  // Whether this place appears in the city Community directory page.
  // Places an artist is connected to but that aren't part of the curated
  // directory (closed venues, schools, etc.) are still listed on the
  // artist's profile, just not linked or shown on the Community page.
  inDirectory  Boolean       @default(true)
  createdAt    DateTime      @default(now())

  userId       String?       @unique
  user         User?         @relation(fields: [userId], references: [id])
  artists      ArtistPlace[]
  magicLinkTokens MagicLinkToken[]
  adminNotes   AdminNote[]
}

model ArtistPlace {
  id                String            @id @default(cuid())
  artistId          String
  // A relation points at EITHER an internal Place (placeId, rendered as a link)
  // OR a free-text venue that has no page yet (venueName, rendered as plain
  // text with no link). Artists never create Place records — venues without a
  // page are stored as venueName only. Exactly one of these is set.
  placeId           String?
  venueName         String?
  relationship      PlaceRelationship
  relationshipLabel String?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime          @default(now())

  artist       Artist            @relation(fields: [artistId], references: [id], onDelete: Cascade)
  place        Place?            @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([artistId, placeId, relationship])
  @@index([placeId])
}

enum PlaceRelationship {
  INSTRUCTOR
  STUDENT
  GRANTEE
  EXHIBITING_ARTIST
  MEMBER
  IN_SHOP
  OTHER
}

// ─── Artist Intake (structured data for search) ───────────────────────────────

model ArtistIntake {
  id                   String   @id @default(cuid())
  artistId             String   @unique
  commissionTypes      String[]
  turnaroundWeeks      Int?
  shipsInternationally Boolean  @default(false)
  worksInPerson        Boolean  @default(false)
  notes                String?  @db.Text
  updatedAt            DateTime @updatedAt

  artist               Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

// ─── Cities ───────────────────────────────────────────────────────────────────

model City {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  state               String?
  displayName         String?
  logoOverlayImageUrl String?
  description         String?  @db.Text
  createdAt           DateTime @default(now())

  artists             Artist[]
}

// ─── Community Survey ─────────────────────────────────────────────────────────
// Responses to the "Portland Community Survey" (/survey). Free-text answers
// are nullable since most questions are optional / conditionally shown.

model SurveyResponse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Secret returned only to the client that created this draft; required to
  // PATCH the response afterward. Prevents anyone else from overwriting it.
  draftToken  String?   @unique
  // Set when the respondent reaches the final submit. Rows without it are
  // abandoned drafts (the form autosaves on every step).
  completedAt DateTime?

  // About Portland
  portlandFamiliarity   String?
  portlandWords         String[] @default([]) // kept for historical responses
  portlandHelpers       String?  @db.Text
  portlandSupport       String[] @default([])
  portlandSupportOther  String?
  portlandWish          String?  @db.Text // kept for historical responses
  discoveryEase         String?
  discoveryChannel      String[] @default([])
  discoveryChannelOther String?

  // About You
  occupation        String[] @default([])
  occupationOther   String?
  artistStatus      String?
  artistStatusOther String?
  artMedium         String[] @default([])
  artMediumOther    String?
  careerStage       String?
  careerStageOther  String?
  ageRange          String?

  // Where are you based
  zipCode       String? // Q6
  neighborhoods String?  @db.Text // Q7

  // About Multnomah Village
  mvFamiliarity    String? // Q8
  mvWords          String[] @default([]) // Q9 — three words (deprecated, kept for old responses)
  mvConnectionLevel String? // How connected do you feel to the artist community in MV?
  mvHelpers        String?  @db.Text // What people/places helped you discover artists in MV?
  mvSupport        String[] @default([]) // How would you most like to connect with/support artists in MV?
  mvSupportOther   String? // Write-in for "Other" in mvSupport

  // Multnomah Days 2026 (deprecated — kept for old responses)
  multnomahDaysInvolvement String[] @default([])

  // About Your Practice
  practiceActivities      String[] @default([])
  practiceActivitiesOther String?
  practiceGoals           String[] @default([])
  practiceGoalsOther      String?
  practiceSupport         String?  @db.Text

  // Become a Featured Artist (deprecated — kept for old responses)
  featuredArtistInterest String?

  // Stay in Touch (deprecated — kept for old responses)
  stayConnected String[] @default([])

  // Get Involved (replaces featured artist + stay connected + multnomah days)
  involvementInterests      String[] @default([])
  involvementInterestsOther String?

  // Raffle + Email
  raffleOptIn String?
  email       String?

  // Referral
  learnedAbout          String[] @default([])
  connectionSuggestions String?  @db.Text
  openFeedback          String?  @db.Text

  // Where the respondent came from — the ?src= URL param captured on load
  // (e.g. "flyer", "instagram", "org_alpha", "homepage_button", "nav_menu"),
  // or "website" when no param is present.
  source String? @default("website")

  // Admin
  isTest Boolean @default(false) // flagged by admin to exclude from reporting

  @@index([createdAt])
}

// ─── Magic Link Tokens ────────────────────────────────────────────────────────
// One-time links sent to featured-artist opt-ins after survey completion.
// A token is single-use and expires after 72 hours.

model MagicLinkToken {
  id        String   @id @default(cuid())
  // Set by the app with crypto.randomBytes — cuid() is not suitable for
  // bearer tokens (partially predictable).
  token     String   @unique
  email     String
  artistId  String?
  placeId   String?
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  artist Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)
  place  Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([placeId])
}

// ─── Contact Form Submissions ────────────────────────────────────────────────

model ContactSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  social    String?
  message   String?  @db.Text
  intent    String?
}

// ─── Admin Notes ──────────────────────────────────────────────────────────────

model AdminNote {
  id        String   @id @default(cuid())
  // Polymorphic: a note belongs to EITHER an artist or a place. Exactly one of
  // artistId / placeId is set.
  artistId  String?
  placeId   String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  place     Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([placeId])
}

// ─── Image Focal Points ───────────────────────────────────────────────────────
// Auto-detected focus for framing an image: the point (as %) that should stay
// centered when the image is cropped to fit a hero/thumbnail/tile, chosen to
// keep faces and the main subject in frame. Keyed by image URL so it works
// uniformly for artist records and places' plain-URL images. Computed by Claude
// vision on upload (and backfillable). Absent = fall back to center.
model ImageFocus {
  url       String   @id
  x         Float // 0–100, horizontal focal point as a percentage
  y         Float // 0–100, vertical focal point as a percentage
  scale     Float    @default(1) // zoom factor (1 = fit/cover, >1 zooms in)
  manual    Boolean  @default(false) // set by a human; auto-detection won't overwrite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Home Logo Animation ───────────────────────────────────────────────────
// The masked "ART HERE" mark on the home/survey/login pages cycles through
// these in order: solid `color`, then a left-to-right wipe reveals `imageUrl`
// (credited to `artistName`), holds, then dissolves into the *next* slide's
// color and repeats. sortOrder is the only thing that matters for ordering —
// ids are never assumed sequential.
model LogoSlide {
  id         String   @id @default(cuid())
  sortOrder  Int      @default(0)
  color      String // hex shown before this slide's image wipes in
  imageUrl   String
  artistName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Profile Revision History ─────────────────────────────────────────────────
// An append-only audit trail: one row is written on every profile save (artist
// or place), capturing the full post-save state as JSON. Never updated or
// deleted by the app — it's the record of "what was shared" over time. Not a
// foreign-key relation on purpose, so a revision survives even if the artist or
// place row is later deleted.

model ProfileRevision {
  id          String   @id @default(cuid())
  entityType  String   // "artist" | "place"
  entityId    String   // the Artist.id or Place.id this revision belongs to
  editedBy    String   // "artist" | "place" | "admin" | "system"
  editorEmail String?  // email of the account that made the change, when known
  snapshot    Json     // full profile snapshot (fields + relations + image list)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
